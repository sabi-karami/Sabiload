{
  "name": "sabiload",
  "productName": "Sabiload",
  "version": "1.0.0",
  "description": "Blazing-fast multi-network download manager: combine Wi-Fi, Ethernet and mobile data into one super connection.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Saheb Karami",
    "email": "saheb.karami@gmail.com",
    "url": "https://github.com/sabi-karami"
  },
  "homepage": "https://sabi-karami.github.io/Sabiload/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabi-karami/Sabiload.git"
  },
  "bugs": "https://github.com/sabi-karami/Sabiload/issues",
  "license": "MIT",
  "keywords": [
    "download-manager",
    "multi-network",
    "bonding",
    "electron",
    "idm",
    "accelerator",
    "sabiload"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:extension": "node scripts/build-extension.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  }
}
